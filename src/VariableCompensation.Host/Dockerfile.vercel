FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src
COPY . .

RUN dotnet restore src/VariableCompensation.Host/VariableCompensation.Host.csproj
RUN dotnet publish src/VariableCompensation.Host/VariableCompensation.Host.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

WORKDIR /app
COPY --from=build /app/publish .

CMD ["sh", "-c", "dotnet VariableCompensation.Host.dll --urls http://0.0.0.0:${PORT:-80}"]
